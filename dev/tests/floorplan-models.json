// Floorplan card: 3D models (`model`: aquarium, car, pellet stove), their animations and `see_through`.
// dev/.venv/bin/python dev/ui_test.py dev/tests/floorplan-models.json
{
  "path": "/plooum-test/floorplan",
  "viewport": [1700, 1050],
  "tests": [
    {
      "name": "every model renders, animated and see-through",
      "steps": [
        { "js": "await T.card.call('input_boolean', 'turn_on', { entity_id: ['input_boolean.pellet_stove', 'input_boolean.aquarium_co2', 'input_boolean.aquarium_60_air', 'input_boolean.car_home'] }); S.card = await waitFor(() => T.card.all('ha-plooum-floorplan-card').find((c) => c.config.title === '3D models' && c._frame3d), 15000, 'the 3D models card'); S.cfg = JSON.parse(JSON.stringify(S.card.config)); S.modes = () => S.card._frame3d.meshes.reduce((n, m) => ((n[m.mode] = (n[m.mode] || 0) + 1), n), {}); await waitFor(() => (S.modes()[6] || 0) === 3, 8000, 'three fires');" },
        { "assert": "S.modes()[7] >= 4", "msg": "bubbles: the air pump's columns and the CO2 mist" },
        { "assert": "(() => { const keys = S.card._frame3d.meshes.filter((m) => m.tex && m.tex.key.startsWith('aquarium-temp:')).map((m) => m.tex.key); return keys.length === 2 && keys.some((k) => k.includes(T.hass().states['sensor.aquarium_temperature'].state)) && keys.some((k) => k.includes(T.hass().states['sensor.aquarium_60l_temperature'].state)); })()", "msg": "each aquarium's thermometer reads its temperature (temperature_entity, or its own sensor)" },
        { "assert": "S.card._frame3d.meshes.filter((m) => m.xray).length >= 9 && S.card._frame3d.animated && !!S.card._animFrame", "msg": "the models are see-through and the view animates" },
        { "assert": "!S.card.shadowRoot.querySelector('.gl-error')", "msg": "WebGL is up (the shaders compile)" },
        { "js": "S.card.setConfig({ ...S.cfg, see_through: false }); S.card.requestUpdate(); await S.card.updateComplete;" },
        { "assert": "S.card._frame3d.meshes.every((m) => !m.xray)", "msg": "see_through: false: nothing shows through walls" },
        { "js": "S.card.setConfig(S.cfg); S.card.requestUpdate(); await S.card.updateComplete;" },
        { "shot": "floorplan-models.png" }
      ]
    },
    {
      "name": "the stove's fire and the aquarium's bubbles follow their entities",
      "steps": [
        { "js": "S.card = await waitFor(() => T.card.all('ha-plooum-floorplan-card').find((c) => c.config.title === '3D models' && c._frame3d), 15000, 'the 3D models card'); S.modes = () => S.card._frame3d.meshes.reduce((n, m) => ((n[m.mode] = (n[m.mode] || 0) + 1), n), {}); await T.card.call('input_boolean', 'turn_off', { entity_id: ['input_boolean.pellet_stove', 'input_boolean.aquarium_co2', 'input_boolean.aquarium_60_air'] });" },
        { "js": "await waitFor(() => !S.modes()[6] && !S.modes()[7], 8000, 'no fire, no bubbles');" },
        { "assert": "!S.card._frame3d.meshes.some((m) => m.animated && m.kind !== 'charge-light')", "msg": "no fire, no bubbles left animated" },
        { "js": "await T.card.call('input_boolean', 'turn_on', { entity_id: ['input_boolean.pellet_stove', 'input_boolean.aquarium_co2', 'input_boolean.aquarium_60_air'] }); await waitFor(() => S.modes()[6] === 3 && S.modes()[7] >= 4, 8000, 'fires and bubbles back');" }
      ]
    },
    {
      "name": "the car only shows when home",
      "steps": [
        { "js": "S.card = await waitFor(() => T.card.all('ha-plooum-floorplan-card').find((c) => c.config.title === 'Home in 3D' && c._frame3d), 15000, 'the 3D card'); S.xray = () => S.card._frame3d.meshes.filter((m) => m.kind === 'car').length; await T.card.call('input_boolean', 'turn_on', { entity_id: 'input_boolean.car_home' }); await waitFor(() => T.hass().states['sensor.car_location'].state === 'home', 8000, 'car home'); S.card.requestUpdate(); await S.card.updateComplete; S.home = S.xray();" },
        { "js": "await T.card.call('input_boolean', 'turn_off', { entity_id: 'input_boolean.car_home' }); await waitFor(() => S.xray() === S.home - 1, 8000, 'the car gone');" },
        { "js": "await T.card.call('input_boolean', 'turn_on', { entity_id: 'input_boolean.car_home' }); await waitFor(() => S.xray() === S.home, 8000, 'the car back');" }
      ]
    },
    {
      "name": "a car shows its battery: level, charging, plugged in",
      "steps": [
        { "js": "S.card = await waitFor(() => T.card.all('ha-plooum-floorplan-card').find((c) => c.config.title === '3D models' && c._frame3d), 15000, 'the 3D models card'); S.was = ['car_plugged', 'car_charging'].map((k) => T.hass().states['input_boolean.' + k].state); S.badges = () => S.card._frame3d.meshes.filter((m) => m.kind === 'battery').map((m) => m.tex.key); S.lights = () => S.card._frame3d.meshes.filter((m) => m.kind === 'charge-light').map((m) => m.mode); await T.card.call('input_boolean', 'turn_on', { entity_id: ['input_boolean.car_plugged', 'input_boolean.car_charging'] }); await T.card.call('input_number', 'set_value', { entity_id: 'input_number.car_battery', value: 15 }); await waitFor(() => S.badges().length === 3 && S.badges().every((k) => k.startsWith('battery:15:')), 8000, 'three badges at 15 %');" },
        { "assert": "S.badges().filter((k) => k.startsWith('battery:15:true:true')).length === 1 && S.badges().filter((k) => k.startsWith('battery:15:false:true')).length === 1 && S.badges().filter((k) => k.startsWith('battery:15:false:false')).length === 1", "msg": "the Spring charges, the city car is plugged in, the sedan shows its level only (the SUV, on a switch, has no badge)" },
        { "assert": "S.lights().sort().join() === '0,8'", "msg": "a pulsing light on the charging car, a steady one on the plugged one" },
        { "js": "await T.card.call('input_boolean', 'turn_off', { entity_id: 'input_boolean.car_plugged' }); await waitFor(() => S.badges().every((k) => k.startsWith('battery:15:false:false')) && !S.lights().length, 8000, 'unplugged: no charge, no light');" }
      ],
      "finally": [
        { "js": "for (const [i, k] of ['car_plugged', 'car_charging'].entries()) await T.card.call('input_boolean', S.was[i] === 'on' ? 'turn_on' : 'turn_off', { entity_id: 'input_boolean.' + k }); await T.card.call('input_number', 'set_value', { entity_id: 'input_number.car_battery', value: 72 });" }
      ]
    },
    {
      "name": "the editor sets a model and keeps only its options",
      "path": "/plooum-edit/floorplan?edit=1",
      "steps": [
        { "js": "S.ed = await T.openEditor(0); S.i = S.ed._config.floors[0].entities.findIndex((e) => e.entity === 'switch.tv_plug'); S.ed._selection = { kind: 'entity', index: S.i }; await S.ed.updateComplete; S.forms = () => JSON.stringify(T.deep(S.ed.shadowRoot, 'ha-form').map((f) => f.schema));" },
        { "assert": "S.forms().includes('\"model\"') && !S.forms().includes('location_entity')", "msg": "a 3D model field, no car options yet" },
        { "js": "S.ent = S.ed._config.floors[0].entities[S.i]; S.ed._selectionChanged({ detail: { value: { ...S.ent, model: 'car', variant: 'dacia_spring', direction: 180, color: [10, 20, 30], light_entity: 'light.x', co2_entity: '' } } }, 'entities'); await S.ed.updateComplete;" },
        { "assert": "(() => { const e = S.ed._config.floors[0].entities[S.i]; return e.model === 'car' && !('variant' in e) && !('direction' in e) && !('light_entity' in e) && !('co2_entity' in e) && e.color.join() === '10,20,30'; })()", "msg": "defaults and other models' options are dropped" },
        { "assert": "S.forms().includes('location_entity') && S.forms().includes('dacia_spring')", "msg": "the car's options show" },
        { "js": "S.ed._selectionChanged({ detail: { value: { ...S.ed._config.floors[0].entities[S.i], model: 'pellet_stove', variant: 'sedan' } } }, 'entities'); await S.ed.updateComplete;" },
        { "assert": "(() => { const e = S.ed._config.floors[0].entities[S.i]; return e.model === 'pellet_stove' && !('variant' in e) && !('color' in e); })()", "msg": "a variant of another model and the car's color are dropped" },
        { "js": "S.set = async (v) => { S.ed._selectionChanged({ detail: { value: { ...S.ed._config.floors[0].entities[S.i], ...v } } }, 'entities'); await S.ed.updateComplete; await new Promise((r) => setTimeout(r, 400)); return { ...S.ed._config.floors[0].entities[S.i] }; }; S.a = await S.set({ model: 'aquarium', variant: 'small', length: 0.6 }); S.b = await S.set({ variant: 'large', length: 0.6 }); S.c = await S.set({ length: 1.2 }); S.d = await S.set({ variant: 'medium' });" },
        { "assert": "S.a.variant === 'small' && !('length' in S.a)", "msg": "a size keeps its variant, its own length is dropped" },
        { "assert": "S.b.variant === 'large' && !('length' in S.b)", "msg": "another size: the old size's default length doesn't stick" },
        { "assert": "S.c.length === 1.2 && !('variant' in S.d) && S.d.length === 1.2", "msg": "a length set by hand stays; medium (the default size) is dropped" },
        { "js": "S.ed._selectionChanged({ detail: { value: { entity: S.ed._config.floors[0].entities[S.i].entity, x: S.ed._config.floors[0].entities[S.i].x, y: S.ed._config.floors[0].entities[S.i].y } } }, 'entities'); await S.ed.updateComplete; S.e = await S.set({ model: 'aquarium', length: 1.5 }); S.f = await S.set({ variant: 'nano' });" },
        { "assert": "!('length' in S.e) && !('length' in S.f) && S.f.variant === 'nano'", "msg": "becoming an aquarium: the window's default length (1.5) shown by the form doesn't stick, so a size changes its length" },
        { "assert": "S.forms().includes('Large (150 cm)')", "msg": "the sizes show in the editor" },
        { "js": "await T.cancelDialog();" }
      ]
    }
  ]
}
