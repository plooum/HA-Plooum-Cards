// Smoke suite, one test per card, each on its own /plooum-test/<view> (YAML dashboard): the cards render
// (their real count: the dashboard builds them lazily), the card's main behavior reacts once, and the
// card's editor renders (built without the dialog). Every test restores the states it changes.
// Run it after any card change (about 5 s):
// dev/.venv/bin/python dev/ui_test.py dev/tests/cards-smoke.json [--only <name substring>]
{
  "path": "/plooum-test/all",
  "viewport": [1400, 900],
  "tests": [
    {
      "name": "dpad: renders, reacts, editor",
      "path": "/plooum-test/dpad",
      "steps": [
        { "js": "S.cards = await T.card.rendered('ha-plooum-dpad-card', 2);" },
        { "js": "S.n0 = Number(T.hass().states['counter.ptz_presses'].state); deep(S.cards[0].shadowRoot, '.remote-btn')[0].dispatchEvent(new PointerEvent('pointerup', { bubbles: true, composed: true }));" },
        { "assert": "await T.card.waitState('counter.ptz_presses', (s) => Number(s.state) === S.n0 + 1)", "msg": "a press increments counter.ptz_presses" },
        { "js": "await T.card.editorRenders(S.cards[0]);" }
      ],
      "finally": [
        { "js": "await T.card.call('counter', 'set_value', { entity_id: 'counter.ptz_presses', value: S.n0 });" },
        { "assert": "await T.card.waitState('counter.ptz_presses', (s) => Number(s.state) === S.n0)", "msg": "counter restored" }
      ]
    },
    {
      "name": "cover: renders, reacts, editor",
      "path": "/plooum-test/cover",
      "steps": [
        { "js": "S.cards = await T.card.rendered('ha-plooum-cover-card', 2);" },
        { "js": "S.p0 = T.hass().states['cover.bedroom_cover'].attributes.current_position; await T.card.call('cover', 'set_cover_position', { entity_id: 'cover.bedroom_cover', position: 50 });" },
        { "assert": "await T.card.waitState('cover.bedroom_cover', (s) => s.attributes.current_position === 50)", "msg": "known start position (50)" },
        { "js": "deep(S.cards[0].shadowRoot, '.cover-column')[1].querySelectorAll('.control-icon')[1].click();" },
        { "assert": "await T.card.waitState('cover.bedroom_cover', (s) => s.attributes.current_position < 50)", "msg": "the down button moves the Bedroom cover" },
        { "js": "await T.card.editorRenders(S.cards[0]);" }
      ],
      "finally": [
        { "js": "await T.card.call('cover', 'set_cover_position', { entity_id: 'cover.bedroom_cover', position: S.p0 });" },
        { "assert": "await T.card.waitState('cover.bedroom_cover', (s) => s.attributes.current_position === S.p0)", "msg": "position restored" }
      ]
    },
    {
      "name": "gridicons: renders, reacts, editor",
      "path": "/plooum-test/gridicons",
      "steps": [
        { "js": "S.cards = await T.card.rendered('ha-plooum-gridicons-card', 1);" },
        { "assert": "deep(S.cards[0].shadowRoot, '.icon-wrapper').length === 4", "msg": "on, off, unavailable and missing icons are all there" },
        { "js": "S.s0 = T.hass().states['light.living_room_light'].state; S.tap = () => { const w = deep(S.cards[0].shadowRoot, '.icon-wrapper')[0]; w.dispatchEvent(new MouseEvent('mousedown', { bubbles: true })); w.dispatchEvent(new MouseEvent('mouseup', { bubbles: true })); }; S.tap();" },
        { "assert": "await T.card.waitState('light.living_room_light', (s) => s.state !== S.s0)", "msg": "a tap toggles light.living_room_light" },
        { "js": "await T.card.editorRenders(S.cards[0]);" }
      ],
      "finally": [
        { "js": "if (S.s0) await T.card.call('input_boolean', S.s0 === 'on' ? 'turn_on' : 'turn_off', { entity_id: 'input_boolean.living_room_light' });" },
        { "assert": "await T.card.waitState('light.living_room_light', (s) => s.state === S.s0)", "msg": "light restored" }
      ]
    },
    {
      "name": "berlin-clock: renders, reads the time, editor",
      "path": "/plooum-test/berlin-clock",
      "steps": [
        { "js": "S.cards = await T.card.rendered('ha-plooum-berlin-clock-card', 2); S.C = customElements.get('ha-plooum-berlin-clock-card');" },
        { "assert": "deep(S.cards[0].shadowRoot, '.lamp').length === 24", "msg": "24 lamps" },
        { "assert": "(() => { const l = S.C.lamps(13, 37, 42); return l.seconds === true && l.rows.map((r) => r.filter(Boolean).length).join() === '2,3,7,2'; })()", "msg": "13:37:42 reads 2 / 3 / 7 / 2, seconds lit" },
        { "assert": "(() => { const l = S.C.lamps(0, 0, 1); return l.seconds === false && l.rows.every((r) => r.every((x) => !x)); })()", "msg": "00:00:01 lights nothing" },
        { "js": "await T.card.editorRenders(S.cards[0]);" }
      ]
    },
    {
      "name": "sky: renders, computes the sky, drags the time, next event, editor",
      "path": "/plooum-test/sky",
      "steps": [
        { "js": "S.cards = await T.card.rendered('ha-plooum-sky-card', 2); S.C = customElements.get('ha-plooum-sky-card'); S.sky = S.C.skyAt(new Date('2026-10-15T22:00:00Z'), 48.86, 2.35); S.polaris = 71;" },
        { "assert": "S.sky.sunAlt < -18", "msg": "22:00 UTC in Paris in October is astronomical night", "show": "S.sky.sunAlt" },
        { "assert": "Math.abs(S.sky.stars[S.polaris].alt - 48.86) <= 1", "msg": "Polaris (the star nearest to ra 37.95, dec 89.26) stands at the latitude", "show": "S.sky.stars[S.polaris].alt" },
        { "assert": "deep(S.cards[0].shadowRoot, '.stars circle').length >= 100", "msg": "at least 100 stars are drawn", "show": "deep(S.cards[0].shadowRoot, '.stars circle').length" },
        { "js": "S.svg = deep(S.cards[0].shadowRoot, 'svg.sky')[0]; const r = S.svg.getBoundingClientRect(); const half = r.width * 364 / 400 / 2; const from = { x: r.x + r.width * 0.3, y: r.y + r.height / 2 }; await T.pointerDrag(S.svg, from, { x: from.x + half, y: from.y }); await S.cards[0].updateComplete;" },
        { "assert": "(() => { const t = deep(S.cards[0].shadowRoot, '.offset')[0]?.textContent.trim(); const m = /^\\+(\\d) h (\\d\\d)$/.exec(t || ''); return !!m && Math.abs(Number(m[1]) * 60 + Number(m[2]) - 180) <= 5; })()", "msg": "half a dome to the right reads about +3 h 00", "show": "deep(S.cards[0].shadowRoot, '.offset')[0]?.textContent" },
        { "js": "S.svg.dispatchEvent(new MouseEvent('dblclick', { bubbles: true, composed: true })); await S.cards[0].updateComplete;" },
        { "assert": "deep(S.cards[0].shadowRoot, '.offset').length === 0", "msg": "a double-click removes the offset" },
        { "assert": "S.cards[0].shouldUpdate(new Map([['hass', S.cards[0].hass]])) === false && S.cards[0].shouldUpdate(new Map([['_offset', 0]])) === true", "msg": "a hass change alone does not redraw the sky" },
        { "js": "S.cards[0]._now = new Date('2026-06-21T12:00:00Z'); await S.cards[0].updateComplete;" },
        { "assert": "Number(deep(S.cards[0].shadowRoot, '.stars')[0].getAttribute('opacity')) >= 0.8 && deep(S.cards[0].shadowRoot, '.stars circle').length > 0", "msg": "by day the stars stay visible", "show": "deep(S.cards[0].shadowRoot, '.stars')[0].getAttribute('opacity')" },
        { "js": "S.cards[0]._now = new Date(); await S.cards[0].updateComplete;" },
        { "js": "S.E = S.C.eventsBetween(new Date('2026-08-01T00:00:00Z'), new Date('2026-09-30T00:00:00Z'), 48.86, 2.35); S.near = (type, kind, iso) => S.E.some((e) => e.type === type && (!kind || e.kind === kind) && Math.abs(e.date - new Date(iso)) <= 3600000);" },
        { "assert": "S.E.every((e, i) => i === 0 || S.E[i - 1].date <= e.date) && S.E.some((e) => e.name === 'Perseids meteor shower') && S.near('meteor_shower', null, '2026-08-12T16:48:00Z')", "msg": "events are sorted and the Perseids peak on 12 Aug 2026 16:48 UTC", "show": "JSON.stringify(S.E.map((e) => [e.type, e.date]))" },
        { "assert": "S.near('solar_eclipse', 'partial', '2026-08-12T18:17:00Z') && S.near('lunar_eclipse', 'partial', '2026-08-28T04:13:00Z') && S.near('equinox', null, '2026-09-23T00:06:00Z')", "msg": "the partial solar eclipse, the partial lunar eclipse and the equinox of Aug-Sep 2026", "show": "JSON.stringify(S.E.map((e) => [e.type, e.date]))" },
        { "assert": "(() => { const c = S.C.eventsBetween(new Date('2026-05-25T00:00:00Z'), new Date('2026-06-25T00:00:00Z'), 48.86, 2.35).filter((e) => e.type === 'conjunction' && e.bodies.includes('Venus') && e.bodies.includes('Jupiter')); return c.length === 1 && Math.abs(c[0].date - new Date('2026-06-10T00:00:00Z')) <= 86400000 && c[0].separation < 2; })()", "msg": "Venus and Jupiter are in conjunction around 10 Jun 2026" },
        { "assert": "(() => { const m = S.C.eventsBetween(new Date('2026-10-20T00:00:00Z'), new Date('2026-12-01T00:00:00Z'), 48.86, 2.35).filter((e) => e.type === 'full_moon'); return m.length === 2 && m[0].supermoon === false && m[1].supermoon === true && m[1].name === 'Supermoon'; })()", "msg": "the 26 Oct 2026 full Moon is not a supermoon, the 24 Nov one is" },
        { "js": "S.peak = S.E.find((e) => e.name === 'Perseids meteor shower').date; S.cards[0]._now = new Date(S.peak.getTime() - 3 * 3600000); await S.cards[0].updateComplete; S.banner = deep(S.cards[0].shadowRoot, '.event')[0];" },
        { "assert": "S.banner && S.banner.textContent.includes('Perseids') && S.banner.classList.contains('reachable')", "msg": "3 h before the peak, the banner announces the Perseids and is tappable", "show": "S.banner?.textContent" },
        { "js": "S.banner.click(); await S.cards[0].updateComplete;" },
        { "assert": "(() => { const m = /^\\+(\\d) h (\\d\\d)$/.exec(deep(S.cards[0].shadowRoot, '.offset')[0]?.textContent.trim() || ''); return !!m && Math.abs(Number(m[1]) * 60 + Number(m[2]) - 180) <= 5; })()", "msg": "tapping the banner brings the dome to +3 h 00", "show": "deep(S.cards[0].shadowRoot, '.offset')[0]?.textContent" },
        { "js": "S.cards[0]._now = new Date(); S.cards[0]._offset = 0; await S.cards[0].updateComplete;" },
        { "js": "S.cfg = S.cards[0].config; S.cards[0].setConfig({ ...S.cfg, show_next_event: false }); await S.cards[0].updateComplete;" },
        { "assert": "deep(S.cards[0].shadowRoot, '.event').length === 0", "msg": "show_next_event: false removes the banner" },
        { "js": "S.cards[0].setConfig(S.cfg); await S.cards[0].updateComplete;" },
        { "assert": "deep(S.cards[0].shadowRoot, '.event').length === 1", "msg": "the banner is back with the original config" },
        { "js": "await T.card.editorRenders(S.cards[0]);" },
        { "js": "S.edit = async (card) => { const ed = await customElements.get(card.localName).getConfigElement(); ed.hass = T.hass(); ed.setConfig(card.config); card.parentNode.append(ed); await ed.updateComplete; S.ed = ed; S.got = []; ed.addEventListener('config-changed', (e) => S.got.push(e.detail.config)); return ed; }; const ed = await S.edit(S.cards[0]); await waitFor(() => deep(ed.shadowRoot, 'ha-selector-location').length, 8000, 'location selector'); S.sel = deep(ed.shadowRoot, 'ha-selector-location')[0];" },
        { "assert": "S.sel.value.latitude === T.hass().config.latitude && S.sel.value.longitude === T.hass().config.longitude", "msg": "the picker starts on the Home Assistant location", "show": "JSON.stringify(S.sel.value)" },
        { "assert": "!S.ed.shadowRoot.querySelector('.home')", "msg": "no home button without a chosen position" },
        { "js": "S.ed.shadowRoot.querySelector('ha-form').dispatchEvent(new CustomEvent('value-changed', { detail: { value: { title: 'x', location: { latitude: -33.87, longitude: 151.21 } } } })); await S.ed.updateComplete;" },
        { "assert": "S.got.length === 1 && S.got[0].latitude === -33.87 && S.got[0].longitude === 151.21 && !('location' in S.got[0])", "msg": "picking a place writes latitude and longitude, not location", "show": "JSON.stringify(S.got)" },
        { "js": "S.ed.remove(); const ed = await S.edit(S.cards[1]); await waitFor(() => ed.shadowRoot.querySelector('.home'), 8000, 'home button'); ed.shadowRoot.querySelector('.home').click();" },
        { "assert": "S.got.length === 1 && !('latitude' in S.got[0]) && !('longitude' in S.got[0]) && !('location' in S.got[0])", "msg": "the home button removes latitude and longitude", "show": "JSON.stringify(S.got)" },
        { "js": "S.ed.remove();" }
      ]
    },
    {
      "name": "tabbed: renders, reacts, editor",
      "path": "/plooum-test/tabbed",
      "steps": [
        { "js": "S.cards = await T.card.rendered('ha-plooum-tabs-card', 1);" },
        { "js": "S.tabs = deep(S.cards[0].shadowRoot, '.tab-button'); S.tabs[1].click(); await S.cards[0].updateComplete;" },
        { "assert": "S.tabs.length === 2 && deep(S.cards[0].shadowRoot, '.tab-pane')[1].style.display === 'flex' && deep(S.cards[0].shadowRoot, '.tab-pane')[0].style.display === 'none'", "msg": "a click on the second tab shows its pane" },
        { "js": "await T.card.editorRenders(S.cards[0]);" }
      ]
    },
    {
      "name": "button-badge: renders, reacts, editor",
      "path": "/plooum-test/button-badge",
      "steps": [
        { "js": "S.cards = await T.card.rendered('ha-plooum-buttonbadge-card', 2);" },
        { "js": "S.s0 = T.hass().states['light.living_room_light'].state; S.tap = () => { const c = deep(S.cards[0].shadowRoot, 'ha-card')[0]; c.dispatchEvent(new PointerEvent('pointerdown', { bubbles: true, composed: true })); c.dispatchEvent(new PointerEvent('pointerup', { bubbles: true, composed: true })); }; S.tap();" },
        { "assert": "await T.card.waitState('light.living_room_light', (s) => s.state !== S.s0)", "msg": "a tap toggles light.living_room_light" },
        { "js": "await T.card.editorRenders(S.cards[0]);" }
      ],
      "finally": [
        { "js": "if (S.s0) await T.card.call('input_boolean', S.s0 === 'on' ? 'turn_on' : 'turn_off', { entity_id: 'input_boolean.living_room_light' });" },
        { "assert": "await T.card.waitState('light.living_room_light', (s) => s.state === S.s0)", "msg": "light restored" }
      ]
    },
    {
      "name": "multistatus: renders, reacts, editor",
      "path": "/plooum-test/multistatus",
      "steps": [
        { "js": "S.cards = await T.card.rendered('ha-plooum-multi-status-card', 6);" },
        { "js": "S.ic = () => deep(S.cards[0].shadowRoot, 'ha-icon').map((i) => i.getAttribute('icon') || i.icon).join(); S.i0 = S.ic(); S.on0 = T.hass().states['input_boolean.aquarium_pump'].state; await T.card.call('input_boolean', 'toggle', { entity_id: 'input_boolean.aquarium_pump' });" },
        { "assert": "await waitFor(() => S.ic() !== S.i0, 8000, 'the pump icon to change')", "msg": "toggling the pump changes the icon" },
        { "js": "await T.card.editorRenders(S.cards[0]);" }
      ],
      "finally": [
        { "js": "if (S.on0) await T.card.call('input_boolean', S.on0 === 'on' ? 'turn_on' : 'turn_off', { entity_id: 'input_boolean.aquarium_pump' });" },
        { "assert": "await T.card.waitState('input_boolean.aquarium_pump', (s) => s.state === S.on0)", "msg": "pump restored" }
      ]
    },
    {
      "name": "temp-humidity: renders, reacts, editor",
      "path": "/plooum-test/temp-humidity",
      "steps": [
        { "js": "S.cards = await T.card.rendered('ha-plooum-temp-humidity-card', 12);" },
        { "js": "S.v0 = Number(T.hass().states['input_number.living_room_temperature'].state); await T.card.call('input_number', 'set_value', { entity_id: 'input_number.living_room_temperature', value: 27.3 });" },
        { "assert": "await waitFor(() => S.cards[0].shadowRoot.textContent.includes('27.3'), 8000, '27.3 on the card')", "msg": "the new temperature is shown" },
        { "js": "await T.card.editorRenders(S.cards[0]);" }
      ],
      "finally": [
        { "js": "await T.card.call('input_number', 'set_value', { entity_id: 'input_number.living_room_temperature', value: S.v0 });" },
        { "assert": "await T.card.waitState('input_number.living_room_temperature', (s) => Number(s.state) === S.v0)", "msg": "temperature restored" }
      ]
    },
    {
      "name": "vivarium: renders, reacts, editor",
      "path": "/plooum-test/vivarium",
      "steps": [
        { "js": "S.cards = await T.card.rendered('ha-plooum-vivarium-card', 18);" },
        { "js": "S.v0 = Number(T.hass().states['input_number.aquarium_60_temperature'].state); S.c = S.cards.find((c) => c.config.name === 'Aquarium 60L'); await T.card.call('input_number', 'set_value', { entity_id: 'input_number.aquarium_60_temperature', value: 24.7 });" },
        { "assert": "await waitFor(() => S.c.shadowRoot.textContent.includes('24.7'), 8000, '24.7 on the Aquarium 60L card')", "msg": "the new temperature is shown" },
        { "js": "await T.card.editorRenders(S.cards[0]);" }
      ],
      "finally": [
        { "js": "await T.card.call('input_number', 'set_value', { entity_id: 'input_number.aquarium_60_temperature', value: S.v0 });" },
        { "assert": "await T.card.waitState('input_number.aquarium_60_temperature', (s) => Number(s.state) === S.v0)", "msg": "temperature restored" }
      ]
    },
    {
      "name": "floorplan: renders, reacts, editor",
      "path": "/plooum-test/floorplan",
      "steps": [
        { "js": "S.cards = await T.card.rendered('ha-plooum-floorplan-card', 6);" },
        { "js": "S.v0 = Number(T.hass().states['input_number.living_room_temperature'].state); await T.card.call('input_number', 'set_value', { entity_id: 'input_number.living_room_temperature', value: 27.3 });" },
        { "assert": "await waitFor(() => S.cards[0].shadowRoot.textContent.includes('27.3'), 8000, '27.3 on the plan')", "msg": "the new temperature is shown on the plan" },
        { "js": "await T.card.editorRenders(S.cards[0]);" }
      ],
      "finally": [
        { "js": "await T.card.call('input_number', 'set_value', { entity_id: 'input_number.living_room_temperature', value: S.v0 });" },
        { "assert": "await T.card.waitState('input_number.living_room_temperature', (s) => Number(s.state) === S.v0)", "msg": "temperature restored" }
      ]
    }
  ]
}
